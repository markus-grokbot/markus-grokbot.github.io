{
 "$schema": "https://json-schema.org/draft/2020-12/schema",
 "$id": "https://markus-grokbot.github.io/schema/gameplay-log.v1.schema.json",
 "title": "gameplay-log v1 (game-agnostic), current minor 1.1.0",
 "type": "object",
 "required": [
  "schema",
  "schemaVersion",
  "game",
  "run",
  "levels",
  "transitions"
 ],
 "properties": {
  "schema": {
   "const": "gameplay-log"
  },
  "schemaVersion": {
   "type": "string",
   "pattern": "^1\\."
  },
  "game": {
   "type": "object",
   "required": [
    "id",
    "version",
    "iteration",
    "namespace"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "version": {
     "type": "string"
    },
    "iteration": {
     "type": "integer",
     "minimum": 1
    },
    "namespace": {
     "type": "string",
     "description": "key used under levels[].ext for game-specific fields"
    }
   }
  },
  "run": {
   "type": "object",
   "required": [
    "id",
    "type",
    "startedAt"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "type": {
     "enum": [
      "human",
      "sim"
     ]
    },
    "startedAt": {
     "type": "string",
     "format": "date-time"
    },
    "endedAt": {
     "type": [
      "string",
      "null"
     ]
    },
    "device": {
     "type": "object",
     "description": "ua/screen/dpr/touch for human; platform/headless for sim"
    },
    "player": {
     "type": "object",
     "description": "{kind:'human',handle} or {kind:'heuristic-bot',skill}"
    },
    "seed": {
     "type": [
      "integer",
      "null"
     ]
    },
    "tuningSource": {
     "type": "string"
    }
   }
  },
  "session": {
   "type": "object",
   "description": "1.1.0 optional: multi-segment session (e.g. combo = tetris then pairwise)",
   "required": [
    "id",
    "kind",
    "segments"
   ],
   "properties": {
    "id": {
     "type": "string"
    },
    "kind": {
     "type": "string"
    },
    "segments": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "index",
       "levelIndex",
       "kind"
      ],
      "properties": {
       "index": {
        "type": "integer"
       },
       "levelIndex": {
        "type": "integer",
        "description": "index into levels[]"
       },
       "kind": {
        "enum": [
         "tetris",
         "pairwise"
        ]
       },
       "outcome": {
        "type": [
         "string",
         "null"
        ]
       },
       "durationMs": {
        "type": [
         "number",
         "null"
        ]
       }
      }
     }
    }
   }
  },
  "levels": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "level",
     "params",
     "outcome",
     "durationMs",
     "metrics"
    ],
    "properties": {
     "level": {
      "type": "integer"
     },
     "params": {
      "type": "object",
      "description": "ALL tunable parameters active in this level (flat key->value). Transitions diff these."
     },
     "startedAt": {
      "type": "string"
     },
     "endedAt": {
      "type": [
       "string",
       "null"
      ]
     },
     "durationMs": {
      "type": [
       "number",
       "null"
      ]
     },
     "outcome": {
      "enum": [
       "complete",
       "fail",
       "abandoned",
       null
      ]
     },
     "metrics": {
      "type": "object",
      "description": "generic: durationMs, score, actions, misplays, progress (0..1)",
      "properties": {
       "durationMs": {
        "type": "number"
       },
       "score": {
        "type": "number"
       },
       "actions": {
        "type": "number"
       },
       "misplays": {
        "type": "number"
       },
       "progress": {
        "type": "number"
       }
      }
     },
     "events": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "t",
        "type"
       ],
       "properties": {
        "t": {
         "type": "number",
         "description": "ms since level start"
        },
        "type": {
         "type": "string"
        }
       }
      },
      "description": "tetris 1.1.0: one {type:'lock', how:'hard_drop'|'soft_drop'|'gravity'|'place', pieceNo, pieceType, x, y, rot, linesCleared, holes, maxHeight} per locked piece (count == pieces). 'hard_drop' events are kept for backward compatibility. pairwise: pairwise_decision, pairwise_undo."
     },
     "ext": {
      "type": "object",
      "description": "game-specific metrics keyed by game.namespace, e.g. ext.tetris.lines",
      "properties": {
       "pairwise": {
        "$ref": "#/$defs/pairwiseExt"
       }
      }
     },
     "segment": {
      "type": "string",
      "description": "1.1.0: segment kind of this level inside a session, e.g. 'tetris' | 'pairwise'"
     }
    }
   }
  },
  "transitions": {
   "type": "array",
   "items": {
    "type": "object",
    "required": [
     "from",
     "to",
     "changes"
    ],
    "properties": {
     "from": {
      "type": "integer"
     },
     "to": {
      "type": "integer"
     },
     "fromOutcome": {
      "type": [
       "string",
       "null"
      ]
     },
     "at": {
      "type": "string"
     },
     "changes": {
      "type": "array",
      "items": {
       "type": "object",
       "required": [
        "param",
        "from",
        "to"
       ],
       "properties": {
        "param": {
         "type": "string"
        },
        "from": {},
        "to": {}
       }
      }
     },
     "mechanicsAdded": {
      "type": "array",
      "items": {
       "type": "string"
      },
      "description": "named mechanics introduced at this level (e.g. 'garbage_rows')"
     },
     "mechanicsRemoved": {
      "type": "array",
      "items": {
       "type": "string"
      }
     }
    }
   }
  },
  "summary": {
   "type": [
    "object",
    "null"
   ],
   "properties": {
    "levelsCompleted": {
     "type": "integer"
    },
    "highestLevel": {
     "type": "integer"
    },
    "totalDurationMs": {
     "type": "number"
    }
   }
  }
 },
 "description": "1.1.0 (additive, backward compatible with 1.0.0): optional top-level session {id,kind,segments[]}, optional levels[].segment, ext.pairwise, lock events {how}.",
 "$defs": {
  "pairwiseExt": {
   "type": "object",
   "required": [
    "setId",
    "setVersion",
    "decisions"
   ],
   "properties": {
    "setId": {
     "type": "string"
    },
    "setVersion": {
     "type": "string"
    },
    "demo": {
     "type": "boolean"
    },
    "pairsShown": {
     "type": "integer"
    },
    "decisionsMade": {
     "type": "integer"
    },
    "undos": {
     "type": "integer"
    },
    "decisions": {
     "type": "array",
     "items": {
      "type": "object",
      "required": [
       "pairId",
       "itemA",
       "itemB",
       "choice",
       "decisionTimeMs"
      ],
      "properties": {
       "seq": {
        "type": "integer"
       },
       "pairId": {
        "type": "string"
       },
       "criterion": {
        "type": "string"
       },
       "itemA": {
        "type": "string"
       },
       "itemB": {
        "type": "string"
       },
       "choice": {
        "enum": [
         "A",
         "B",
         "tie",
         "not_enough_info"
        ]
       },
       "winner": {
        "type": [
         "string",
         "null"
        ]
       },
       "strength": {
        "enum": [
         1,
         2,
         3,
         null
        ]
       },
       "decisionTimeMs": {
        "type": "number"
       },
       "reasonTags": {
        "type": "array",
        "items": {
         "type": "string"
        }
       },
       "swapped": {
        "type": "boolean",
        "description": "true if set-B was shown on top/first"
       },
       "undone": {
        "type": "boolean"
       },
       "undoneAt": {
        "type": "string"
       },
       "source": {
        "type": "string",
        "description": "'human' or 'sim:<strategy>'"
       }
      }
     }
    }
   }
  }
 }
}